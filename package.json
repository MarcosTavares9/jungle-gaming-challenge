{
  "name": "jungle-gaming-challenge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun scripts/test-integration.ts",
    "format": "prettier --write src scripts tests package.json tsconfig.json compose.yaml README.md ARCHITECTURE.md",
    "format:check": "prettier --check src scripts tests package.json tsconfig.json compose.yaml README.md ARCHITECTURE.md",
    "db:up": "bun scripts/migrate.ts up",
    "db:down": "bun scripts/migrate.ts down",
    "queues:setup": "bun scripts/setup-queues.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.0.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "decimal.js": "^10.6.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/express": "^5.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0"
  }
}
